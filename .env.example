# Optional: unlock detailed contribution breakdowns via GitHub GraphQL.
# Never prefix this token with NEXT_PUBLIC_.
GH_PAT=
# Set to your deployed origin for QR codes, share links, and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local SQLite file (development). Defaults to file:./data/cache.db when unset.
SQLITE_URL=file:./data/cache.db
# Production (Turso Cloud). When set, the app uses Turso instead of the local file.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

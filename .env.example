# Optional: unlock detailed contribution breakdowns via GitHub GraphQL.
# Never prefix this token with NEXT_PUBLIC_.
GH_PAT=
# Set to your deployed origin for QR codes, share links, and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local SQLite file (development) for the print counter and abuse buckets.
# Defaults to file:./data/app.db when unset.
SQLITE_URL=file:./data/app.db
# Production (Turso Cloud). When set, the app uses Turso instead of the local file.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
# Salt for anonymous IP hashes (rate limiting). Set a random value in production.
RATE_LIMIT_SALT=
# Requests per minute per visitor (0 or unset restores the default after =).
RATE_LIMIT_PAGE=60
RATE_LIMIT_SVG=30
RATE_LIMIT_OG=30
RATE_LIMIT_PDF=10
RATE_LIMIT_PRINTS=10
# Shared GitHub fetches per minute guarding the token quota.
RATE_LIMIT_GITHUB_OUTBOUND=120
